{
  "manifest_version": 3,
  "name": "Quick AutoFill",
  "version": "2.0.0",
  "description": "Record form fills as rules, group them into profiles, and replay them on any page.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Quick AutoFill \u2014 click to show the toolbar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rules.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-bar": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Show/hide the rule recorder toolbar"
    },
    "run-profile": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Run the profile that matches this page"
    }
  },
  "options_ui": {
    "page": "details.html",
    "open_in_tab": true
  }
}